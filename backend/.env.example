# =====================================================================
# TerangaFlow API — environment variables
# Copy this file to `backend/.env` and fill in the values.
# `backend/.env` is git-ignored: NEVER commit real credentials.
# =====================================================================

# --- Application ------------------------------------------------------
# development | staging | production | test
APP_ENV=development
LOG_LEVEL=INFO

# Allowed browser origins (comma-separated, no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database: Supabase PostgreSQL -----------------------------------
# Supabase dashboard > your project > "Connect" > Connection string (URI).
# Replace [YOUR-PASSWORD] with the database password of the project.
#
# Recommended for this API (long-running server) and for Alembic:
#   Session pooler (IPv4 compatible), port 5432:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Also supported:
#   Direct connection (IPv6 only unless the IPv4 add-on is enabled):
#   postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
#   Transaction pooler, port 6543 (serverless): detected automatically —
#   client pooling and prepared statements are disabled for it.
#
# Special characters in the password must be URL-encoded (e.g. @ -> %40).
# Leave empty to run the API without a database (/health still works).
DATABASE_URL=

# Connection pool (ignored for the transaction pooler on port 6543).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
# true = log every SQL statement (debug only)
DB_ECHO=false
