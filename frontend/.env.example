# ---------------------------------------------------------------
# TerangaFlow — frontend environment variables
# Copy this file to `.env.local` and adapt values if needed.
# Only variables prefixed with VITE_ are exposed to the browser:
# NEVER put secrets (database password, service keys) here.
# ---------------------------------------------------------------

# Base URL of the FastAPI backend (versioned prefix included).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Request timeout for API calls, in milliseconds.
VITE_API_TIMEOUT_MS=10000
